# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Milestone 0-3 run entirely on public endpoints. Do not put a venue credential
# in this file: the config layer rejects a credential in the local and research
# environments precisely so that a live key cannot end up in a research
# deployment by accident.

# local | research | demo | live_supervised | live_bounded
ARBBOT_ENVIRONMENT=local

# Port 55432 matches docker-compose, which stays clear of 5432/5433 so that a
# locally installed PostgreSQL cannot shadow the container. Point this wherever
# your database actually is.
ARBBOT_DATABASE_URL=postgresql+psycopg://arbbot:arbbot@localhost:55432/arbbot
ARBBOT_LOG_LEVEL=INFO

# Public venue endpoints.
ARBBOT_VENUE_API_BASE=https://external-api.kalshi.com/trade-api/v2
ARBBOT_VENUE_WS_URL=wss://external-api-ws.kalshi.com/

# Runtime half of the FR-016 live gate. Leave false. Setting it true on a build
# without LIVE_EXECUTION_COMPILED_IN will refuse to start, by design.
ARBBOT_LIVE_TRADING_ENABLED=false

# Risk limits (section 22). These are rejection thresholds, not targets.
ARBBOT_RISK_MAX_ORDER_NOTIONAL_USD=5
ARBBOT_RISK_MAX_UNMATCHED_EXPOSURE_USD=25
ARBBOT_RISK_MAX_TOTAL_OPEN_EXPOSURE_USD=100
ARBBOT_RISK_DAILY_LOSS_LIMIT_USD=10
ARBBOT_RISK_MIN_NET_EDGE_USD=0.02
ARBBOT_RISK_MAX_QUOTE_AGE_MS=2000

# Credentials belong here ONLY in demo and live deployments, and only via your
# secret manager -- never checked in, never pasted into a prompt or an issue.
# ARBBOT_VENUE_API_KEY_ID=
# ARBBOT_VENUE_PRIVATE_KEY_PEM=
