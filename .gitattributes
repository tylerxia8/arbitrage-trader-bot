# Normalise to LF in the repository. Development happens on Windows and CI runs
# on Linux; without this, a checkout difference shows up as a whole-file diff
# and `ruff format --check` disagrees with the machine that wrote the code.
* text=auto eol=lf

# Windows-only files keep CRLF in the working tree.
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.docx binary
*.pdf binary
